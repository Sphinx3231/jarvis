# Jarvis API keys. Copy this to ~/.jarvis/.env (or point $JARVIS_ENV at it), fill in the
# ones you use, and restart Jarvis. Keys you set inside the app (encrypted on disk) take
# precedence over this file, and Jarvis never writes to or logs this file.
#
# Note: your AI model sign-ins (Claude, ChatGPT, Gemini, API keys, local models) are NOT
# here — those live in Roamies (~/.gg). This file is for Jarvis's own integrations.

# Fish Audio — Jarvis's spoken voice (Settings -> Voice -> Jarvis's voice -> Fish Audio)
FISH_AUDIO_KEY=

# HackerOne — the autonomous bug-bounty pipeline (Integrations -> HackerOne)
HACKERONE_TOKEN=

# Voice transcription — only when you run your own Whisper-compatible server with a key
TRANSCRIPTION_API_KEY=

# Email / calendar account passwords (optional; you can also set these in the app)
EMAIL_PASSWORD=
CALDAV_PASSWORD=
