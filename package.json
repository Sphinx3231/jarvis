{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Jarvis — a persistent AI personal operating system, represented by a purple dragon.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "app": "node --disable-warning=ExperimentalWarning scripts/launch.ts",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e/ui.e2e.ts && node --disable-warning=ExperimentalWarning tests/e2e/voice.e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "node-ical": "^0.27.6",
    "nodemailer": "^10.5.0",
    "onnxruntime-web": "^1.31.1",
    "tsdav": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "^1.0.0",
    "@modelcontextprotocol/server-filesystem": "^1.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "hoodiecrow-imap": "^3.3.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
