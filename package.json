{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Jarvis — a persistent AI personal operating system, represented by a purple dragon. Built on Roamies.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "app": "node --disable-warning=ExperimentalWarning scripts/launch.ts",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e/ui.e2e.ts && node --disable-warning=ExperimentalWarning tests/e2e/voice.e2e.ts && node --disable-warning=ExperimentalWarning tests/e2e/computer.e2e.ts && node --disable-warning=ExperimentalWarning tests/e2e/mobile.e2e.ts",
    "build:server": "node -e \"require('fs').rmSync('dist-server',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.copyFileSync('server/llm/claudecode.mjs','dist-server/server/llm/claudecode.mjs');fs.mkdirSync('dist-server/server/voice',{recursive:true});fs.copyFileSync('server/voice/voice_worker.py','dist-server/server/voice/voice_worker.py');fs.mkdirSync('dist-server/server/agents/knowledge',{recursive:true});for(const f of ['ethical-hacking-kb.md','kali-arsenal.md'])fs.copyFileSync('server/agents/knowledge/'+f,'dist-server/server/agents/knowledge/'+f)\"",
    "desktop": "npm run build && npm run build:server && electron .",
    "dist": "npm run build && npm run build:server && electron-builder --publish never",
    "test:computer": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/computer*.test.ts\" tests/learning.test.ts",
    "computer:platform-test": "node --disable-warning=ExperimentalWarning scripts/computer-platform-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@kenkaiiii/gg-agent": "^5.100.2",
    "@kenkaiiii/gg-ai": "^5.100.2",
    "@kenkaiiii/gg-core": "^5.100.2",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "node-ical": "^0.27.6",
    "nodemailer": "^10.5.0",
    "onnxruntime-web": "^1.31.1",
    "tsdav": "^2.5.0",
    "ws": "8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/rajdhani": "5.3.0",
    "@gsap/react": "2.1.2",
    "@modelcontextprotocol/server-everything": "^1.0.0",
    "@modelcontextprotocol/server-filesystem": "^1.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "gsap": "3.15.1",
    "hoodiecrow-imap": "^3.3.1",
    "lenis": "1.3.27",
    "lucide-react": "^1.72.0",
    "qrcode-generator": "1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smtp-server": "^3.21.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "main": "desktop/main.cjs",
  "author": "Jarvis contributors",
  "homepage": "https://github.com/Sphinx3231/jarvis",
  "build": {
    "appId": "app.jarvis.desktop",
    "productName": "Jarvis",
    "copyright": "Jarvis contributors · AGPL-3.0-only · built on Roamies by KenKaiii",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "assets/build"
    },
    "files": [
      "desktop/**",
      "dist-server/**",
      "web/dist/**",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!node_modules/onnxruntime-web/dist/**",
      "node_modules/onnxruntime-web/dist/ort.node.min.{js,mjs}",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{mjs,wasm}",
      "docs/*.md",
      "dist-server/**/*.md",
      "README.md",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "LICENSE",
      "NOTICE.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "assets/build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis listens when you press the microphone button or say its wake word."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/build/icon.png",
      "maintainer": "Jarvis <noreply@example.com>",
      "synopsis": "Your personal AI operating system"
    }
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sphinx3231/jarvis.git"
  }
}
